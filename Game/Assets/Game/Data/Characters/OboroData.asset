  _characterId: Oboro
  _displayName: 朧
  _roleName: 高難度忍者アサシン
  _shortDescription: 黒の忍者。削り、背後攻撃、処刑を得意とする高難度の暗殺者。
  _themeColor: {r: 0.08, g: 0.08, b: 0.1, a: 1}
