  _shortDescription: "\u53CC\u982D\u5263\u3067\u6575\u3092\u5207\u308A\u88C2\u304D\u3001\u9023\u7D9A\u30D6\u30EA\u30F3\u30AF\u3067\u6226\u5834\u3092\u99C6\u3051\u308B\u9752\u306E\u5263\u58EB\u3002"
