  _characterId: Zelf
  _displayName: ゼルフ
  _roleName: 高機動近接ファイター
  _shortDescription: 双頭剣で敵を切り裂き、連続ブリンクで戦場を駆ける青の剣士。
  _themeColor: {r: 0.2, g: 0.45, b: 1, a: 1}
  _characterStatus: 0
  _baseHp: 650
  _hpGrowth: 105
  _baseHpRegeneration: 3.5
  _hpRegenerationGrowth: 0.35
