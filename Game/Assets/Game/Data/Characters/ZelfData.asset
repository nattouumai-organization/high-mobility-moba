  _passiveDescription: "\u6575\u30D2\u30FC\u30ED\u30FC\u306B\u4E0E\u3048\u305F\u30C0\u30E1\u30FC\u30B8\u306E5%\u3092\u56DE\u5FA9\u3059\u308B\u3002\u30DF\u30CB\u30AA\u30F3\u306B\u5BFE\u3059\u308B\u56DE\u5FA9\u91CF\u306F\u534A\u6E1B\u3002"
  _qDescription: "\u30DF\u30CB\u30AA\u30F3\u307E\u305F\u306F\u6575\u30D2\u30FC\u30ED\u30FC\u3078\u30D6\u30EA\u30F3\u30AF\u3057\u3066\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u308B\u3002\u540C\u3058\u5BFE\u8C61\u306B\u306F\u77ED\u6642\u9593\u9023\u7D9A\u3057\u3066\u4F7F\u7528\u3067\u304D\u306A\u3044\u3002\u4ED6\u306E\u30B9\u30AD\u30EB\u3092\u5F53\u3066\u308B\u3068\u518D\u4F7F\u7528\u53EF\u80FD\u306B\u306A\u308B\u3002"
  _wDescription: "\u53CC\u982D\u5263\u3092\u56DE\u8EE2\u3055\u305B\u3001\u77ED\u6642\u9593\u3060\u3051\u524D\u65B9\u304B\u3089\u53D7\u3051\u308B\u901A\u5E38\u30C0\u30E1\u30FC\u30B8\u3092\u8EFD\u6E1B\u3059\u308B\u3002"
  _eDescription: "\u6307\u5B9A\u65B9\u5411\u3078\u30C0\u30C3\u30B7\u30E5\u3057\u3001\u7D4C\u8DEF\u3068\u5C11\u3057\u5148\u306E\u6575\u3078\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u308B\u3002\u6575\u30D2\u30FC\u30ED\u30FC\u306B\u547D\u4E2D\u3059\u308B\u3068Q\u3092\u5373\u6642\u518D\u4F7F\u7528\u53EF\u80FD\u306B\u3059\u308B\u3002"
  _rDescription: "\u6575\u3092\u4E2D\u5FC3\u306B\u6C7A\u95D8\u30A8\u30EA\u30A2\u3092\u4F5C\u308B\u3002\u5468\u56F2\u306E\u6575\u3068\u30DF\u30CB\u30AA\u30F3\u3092\u5916\u3078\u62BC\u3057\u51FA\u3057\u3001\u30A8\u30EA\u30A2\u5185\u306E\u6575\u3092\u30B9\u30ED\u30A6\u3059\u308B\u3002\u5171\u901AD\u3067\u5F3E\u304B\u308C\u305F\u5834\u5408\u306F\u4E0D\u767A\u3002"
