  _passiveDescription: "\u4E00\u5B9A\u6642\u9593\u30C0\u30E1\u30FC\u30B8\u3092\u53D7\u3051\u305A\u306B\u3044\u308B\u3068\u3001\u6B21\u306E\u653B\u6483\u3092\u5B8C\u5168\u306B\u7121\u52B9\u5316\u3059\u308B\u30B7\u30FC\u30EB\u30C9\u3092\u5F97\u308B\u3002\u30B7\u30FC\u30EB\u30C9\u306F\u6D88\u8CBB\u3055\u308C\u308B\u307E\u3067\u6C38\u7D9A\u3057\u3001\u30DF\u30CB\u30AA\u30F3\u306E\u653B\u6483\u3067\u306F\u5265\u304C\u308C\u306A\u3044\u3002\u30BF\u30EF\u30FC\u306E\u653B\u6483\u306F1\u56DE\u7121\u52B9\u5316\u3059\u308B\u304CP\u3092\u6D88\u8CBB\u3059\u308B\u3002"
  _qDescription: "\u5730\u9762\u3092\u53E9\u3044\u3066\u7BC4\u56F2\u653B\u6483\u3002\u5730\u9762\u306B\u4E80\u88C2\u3092\u6B8B\u3057\u3001\u4E80\u88C2\u306E\u4E0A\u306E\u6575\u3092\u30B9\u30ED\u30A6\u3059\u308B\u3002\u540C\u6642\u306B\u8907\u6570\u306E\u4E80\u88C2\u306F\u5B58\u5728\u3057\u306A\u3044\u3002"
  _wDescription: "\u30B7\u30FC\u30EB\u30C9\u3092\u5F97\u308B\u3002\u4E00\u5B9A\u6642\u9593\u5F8C\u306B\u81EA\u52D5\u3067\u7206\u767A\u3057\u3001\u5468\u56F2\u3078\u7BC4\u56F2\u30C0\u30E1\u30FC\u30B8\u3002\u4E0E\u3048\u305F\u30C0\u30E1\u30FC\u30B8\u306E5%\u3092\u56DE\u5FA9\u3057\u3001\u30DF\u30CB\u30AA\u30F3\u76F8\u624B\u306E\u56DE\u5FA9\u306F\u534A\u6E1B\u3002\u624B\u52D5\u3067\u306E\u7206\u767A\u306F\u3067\u304D\u306A\u3044\u3002"
  _eDescription: "\u7A81\u9032\u3057\u3066\u30C0\u30E1\u30FC\u30B8\u3068\u30B9\u30BF\u30F3\u3092\u4E0E\u3048\u308B\u3002\u5171\u901AD\u3067\u5F3E\u304B\u308C\u305F\u5834\u5408\u306F\u30C0\u30E1\u30FC\u30B8\u30FB\u30B9\u30BF\u30F3\u3068\u3082\u4E0D\u767A\u306B\u306A\u308B\u3002"
  _rDescription: "\u9396\u3092\u98DB\u3070\u3057\u3001\u6575\u3068\u4E00\u5B9A\u8DDD\u96E2\u4EE5\u4E0A\u96E2\u308C\u3089\u308C\u306A\u3044\u72B6\u614B\u306B\u3059\u308B\u3002\u52B9\u679C\u6642\u9593\u4E2D\u3001\u6575\u30D2\u30FC\u30ED\u30FC\u304B\u3089\u53D7\u3051\u305F\u30C0\u30E1\u30FC\u30B8\u3092\u78BA\u5B9A\u30C0\u30E1\u30FC\u30B8\u3067\u81EA\u52D5\u53CD\u5C04\u3059\u308B\u3002\u5171\u901AD\u3067\u9396\u3092\u5F3E\u304B\u308C\u3066\u3082\u53CD\u5C04\u306F\u4ED8\u4E0E\u3055\u308C\u308B\u3002\u53CD\u5C04\u306F\u518D\u53CD\u5C04\u305B\u305A\u3001\u30BF\u30EF\u30FC\u30FB\u30DF\u30CB\u30AA\u30F3\u30FB\u8A2D\u7F6E\u7269\u30FB\u81EA\u5DF1\u30C0\u30E1\u30FC\u30B8\u306F\u53CD\u5C04\u5BFE\u8C61\u5916\u3002"
